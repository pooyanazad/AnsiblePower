# AnsiblePower environment variables
# Copy this file to .env and adjust values before running docker compose up

# Optional signing key. Blank generates a persistent random key in data/auth.db.
FLASK_SECRET_KEY=

# Set true when serving over HTTPS (including behind a TLS reverse proxy).
SESSION_COOKIE_SECURE=false

# Enable Flask debug mode (set to "true" for development)
FLASK_DEBUG=false

# Path to ansible-playbook binary (auto-detected if not set)
# ANSIBLE_PLAYBOOK_BIN=ansible-playbook

# Global runner slots (1–8), and per-run timeout in seconds.
ANSIBLEPOWER_RUN_CONCURRENCY=1
ANSIBLEPOWER_RUN_TIMEOUT=300
